{
  "source_repo": "jsdfhasuh/emo-vision-train",
  "release_repo": "jsdfhasuh/emo-vision-train-release",
  "python_version": "3.11",
  "release_asset_name": "emo-vision-train-windows-${RELEASE_TAG}.zip",
  "ci_extra_packages": [
    "torchvision==0.20.1",
    "onnxruntime-gpu==1.23.2",
    "kagglesdk==0.1.37"
  ],
  "entry": "${SOURCE_ROOT}/main.py",
  "prepare_source_assets": "scripts/prepare_desktop_weights.py",
  "name": "VisionWorkshop",
  "onefile": false,
  "console": true,
  "zip_lzma_dictionary_mib": 256,
  "icon": null,
  "add_data": [
    "${SOURCE_ROOT}/ui:ui",
    "${SOURCE_ROOT}/anomaly_func:anomaly_func",
    "${SOURCE_ROOT}/my_ultralytics_func:my_ultralytics_func",
    "${SOURCE_ROOT}/ultralytics/ultralytics:ultralytics",
    "${SOURCE_ROOT}/training_platform.ui:.",
    "${SOURCE_ROOT}/tool.py:.",
    "${SOURCE_ROOT}/static:static",
    "${SOURCE_ROOT}/kaggle_func/templates:kaggle_func\\templates",
    "${SOURCE_ROOT}/kaggle_func/job_builder.py:kaggle_func",
    "${SOURCE_ROOT}/kaggle_func/build_errors.py:kaggle_func",
    "${SOURCE_ROOT}/kaggle_func/runtime_builder.py:kaggle_func",
    "${SOURCE_ROOT}/kaggle_func/runtime_bootstrap.py:kaggle_func",
    "${SOURCE_ROOT}/kaggle_func/runtime/__init__.py:kaggle_func\\runtime",
    "${SOURCE_ROOT}/kaggle_func/runtime/config.py:kaggle_func\\runtime",
    "${SOURCE_ROOT}/kaggle_func/runtime/yolo_train.py:kaggle_func\\runtime",
    "${SOURCE_ROOT}/kaggle_func/runtime/patchcore_train.py:kaggle_func\\runtime",
    "${SOURCE_ROOT}/X-AnyLabeling/anylabeling:X-AnyLabeling\\anylabeling"
  ],
  "hidden_imports": [
    "PyQt5",
    "PyQt5.QtCore",
    "PyQt5.QtGui",
    "PyQt5.QtWidgets",
    "PyQt5.uic",
    "PyQt5.QtWebEngine",
    "PyQt5.QtWebEngineWidgets",
    "torch",
    "torchvision",
    "timm",
    "safetensors.torch",
    "cv2",
    "numpy",
    "PIL",
    "polars",
    "yaml",
    "onnx",
    "onnxruntime",
    "qimage2ndarray",
    "natsort",
    "termcolor",
    "lap",
    "scipy",
    "shapely",
    "psutil",
    "pyclipper",
    "tokenizers",
    "jsonlines",
    "json_repair",
    "kaggle",
    "importlib_metadata",
    "markdown",
    "requests",
    "tqdm",
    "six",
    "openai",
    "termcolor"
  ],
  "excludes": [
    "notebook",
    "notebook_shim",
    "jupyterlab",
    "jupyterlab_server",
    "jupyter_server",
    "jupytext.async_contentsmanager",
    "jupytext.sync_contentsmanager",
    "ipykernel",
    "ipywidgets",
    "IPython.testing",
    "pytest",
    "_pytest"
  ],
  "collect_binaries": [
    "torch",
    "torchvision"
  ],
  "extra_args": [
    "--additional-hooks-dir",
    "${PACKAGER_ROOT}/hooks/vision-train",
    "--copy-metadata",
    "torch",
    "--copy-metadata",
    "torchvision",
    "--copy-metadata",
    "timm",
    "--copy-metadata",
    "safetensors",
    "--copy-metadata",
    "numpy",
    "--copy-metadata",
    "Pillow",
    "--copy-metadata",
    "onnx",
    "--copy-metadata",
    "onnxslim",
    "--collect-all",
    "onnxslim",
    "--copy-metadata",
    "onnxruntime",
    "--copy-metadata",
    "onnxruntime-gpu",
    "--collect-all",
    "kaggle",
    "--collect-all",
    "kagglesdk",
    "--collect-all",
    "kornia",
    "--collect-data",
    "lightning_fabric",
    "--collect-data",
    "rfc3987_syntax",
    "--copy-metadata",
    "kaggle",
    "--copy-metadata",
    "kagglesdk"
  ],
  "update_protocol": 3,
  "updater": {
    "enabled": true,
    "entry": "${SOURCE_ROOT}/updater_gui.py",
    "name": "VisionWorkshopUpdater",
    "onefile": true,
    "console": false,
    "hidden_imports": [],
    "excludes": [
      "torch",
      "torchvision",
      "ultralytics",
      "cv2",
      "PyQt5.QtWebEngineWidgets",
      "PyQt5.QtWebEngineCore"
    ],
    "extra_args": []
  },
  "launcher_min_capability": 1,
  "layout_version": 1
}
